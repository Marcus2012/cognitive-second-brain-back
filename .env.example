BRAIN_ENVIRONMENT=development
BRAIN_DATABASE_URL=sqlite:///./brain.db
# PostgreSQL/Supabase: postgresql+psycopg://USER:PASSWORD@HOST:5432/postgres?sslmode=require
BRAIN_DATABASE_SCHEMA=cognitive_brain
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
BRAIN_JWT_SECRET=replace-this-with-at-least-32-random-characters
BRAIN_CORS_ORIGINS=["http://localhost:3000"]
BRAIN_ACCESS_TOKEN_MINUTES=30
BRAIN_AUTH_RATE_LIMIT=20
