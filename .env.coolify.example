# Variables for compose.coolify.yaml, configured in Coolify (not the local .env).
# Use the actual network alias and URL-encoded password from your Supabase deployment.
BRAIN_DATABASE_URL=postgresql+psycopg://postgres.dev_tenant:URL_ENCODED_PASSWORD@supabase-supavisor:5432/postgres
BRAIN_DATABASE_SCHEMA=cognitive_brain
BRAIN_ENVIRONMENT=production
BRAIN_JWT_SECRET=replace-with-a-dedicated-random-secret-at-least-32-characters
BRAIN_CORS_ORIGINS=["https://YOUR_FRONTEND_DOMAIN"]
SUPABASE_DOCKER_NETWORK=REPLACE_WITH_EXISTING_NETWORK_NAME
